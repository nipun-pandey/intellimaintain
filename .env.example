# ==========================================
# IntelliMaintain Environment Configuration
# ==========================================

# Database
# For SQLite local development: sqlite:///./intellimaintain.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/intellimaintain
DATABASE_URL=sqlite:///./intellimaintain.db

# Security & JWT
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Diagnostics (Optional)
# Leave blank to use deterministic expert rule-based FMEA engine
GEMINI_API_KEY=

# Docker Compose Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=intellimaintain
POSTGRES_PORT=5432
